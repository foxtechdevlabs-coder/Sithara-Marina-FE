# Sithara Marina frontend — environment template.
# Copy to `.env.local` (git-ignored) and adjust the values. In deployed
# environments (e.g. Vercel), set the same variables in the platform's
# environment settings, then redeploy.
#
# WARNING: every `NEXT_PUBLIC_*` variable is inlined into the browser bundle
# at BUILD time. Never put secrets, API keys or tokens in them. A production
# build fails if a required variable is missing or invalid.

# Sithara Marina backend API (no /api prefix; routes are served from the root).
# Full API reference: http://localhost:3000/docs
#
# Local backend:   http://localhost:3000
# Hosted backend:  replace with the hosted URL once the server is deployed,
#                  e.g. https://api.sitharamarina.com
NEXT_PUBLIC_API_URL=http://localhost:3000
