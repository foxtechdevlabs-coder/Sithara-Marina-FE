# Sithara Marina frontend — environment template.
# Copy to `.env.local` (git-ignored) and adjust the values. In deployed
# environments, set the same variables in the platform's environment settings.
#
# WARNING: every `NEXT_PUBLIC_*` variable is inlined into the browser bundle
# at BUILD time. Never put secrets, API keys or tokens in them. A production
# build fails if a required variable is missing or invalid.

# Base URL of the backend API (absolute URL, used by the user and admin areas).
# PLACEHOLDER ONLY — the backend team must confirm the real host, port and
# path prefix. Port 4000 is just an example that avoids the frontend's 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
